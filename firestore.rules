rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Propriedades: só dono pode ler/escrever
    match /propriedades/{propriedadeId} {
      allow read, write: if request.auth != null
        && (resource == null || resource.data.userId == request.auth.uid);
      // create: garante que userId == auth.uid
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
    }

    // Talhoes: só dono da propriedade pai
    match /talhoes/{talhaoId} {
      allow read, write: if request.auth != null
        && get(/databases/$(database)/documents/propriedades/$(resource.data.propriedadeId)).data.userId == request.auth.uid;
      allow create: if request.auth != null
        && get(/databases/$(database)/documents/propriedades/$(request.resource.data.propriedadeId)).data.userId == request.auth.uid;
    }

    // Despesas: só dono da propriedade pai
    match /despesas/{despesaId} {
      allow read, write: if request.auth != null
        && get(/databases/$(database)/documents/propriedades/$(resource.data.propriedadeId)).data.userId == request.auth.uid;
      allow create: if request.auth != null
        && get(/databases/$(database)/documents/propriedades/$(request.resource.data.propriedadeId)).data.userId == request.auth.uid;
    }
  }
}
